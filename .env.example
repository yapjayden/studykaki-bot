# Copy this file to ".env" and fill in your real values:
#   cp .env.example .env
# The .env file is gitignored, so your secrets stay on your machine only.

# Telegram bot token from @BotFather
BOT_TOKEN=your-telegram-bot-token

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Comma-separated Telegram user IDs allowed to moderate, e.g. 12345,67890
MODERATOR_IDS=your-telegram-user-id

# Sightengine image-moderation credentials from https://sightengine.com
SIGHTENGINE_USER=your-sightengine-user
SIGHTENGINE_SECRET=your-sightengine-secret
